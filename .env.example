# Copia este archivo como .env y llena los valores desde
# Consola Firebase → Configuración del proyecto → Tus apps → App web.
# Estos valores NO son secretos (van en el bundle del navegador);
# la seguridad real está en firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "firestore" = demo en plan Spark (imágenes WebP en Firestore)
# "storage"   = producción en plan Blaze (Cloud Storage)
VITE_IMAGE_STORAGE_MODE=firestore

# true = usar Firebase Emulator Suite local (no consume cuota)
VITE_USE_EMULATORS=false
